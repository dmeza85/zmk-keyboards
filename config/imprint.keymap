#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/hid_usage.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    // ========================================================================
    // ADVANCED BEHAVIORS (Adapted from Sunaku's "Glorious Engrammer")
    // ========================================================================

    behaviors {
        // 1. HOME ROW MODS (HRM) - BILATERAL COMBINATIONS
        // Sunaku's "Difficulty Level 2" translates to roughly 200ms tap terms 
        // with a 150ms streak decay. This ensures that at 90wpm, rolling keys 
        // won't accidentally trigger a Shift or Ctrl.

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;

            // NOTE: To make this strictly bilateral (only fires when you press 
            // a key on the opposite hand), you must define your right hand key positions.
            // hold-trigger-key-positions = < 6 7 8 ... >; 

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <70 76 77 71 78 72 73 74 75 79 80 81 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 54 55 56 57 58 59 65 66 67 68 69 75 37 38 39 40>;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <50>;

            // hold-trigger-key-positions = < 0 1 2 ... >; // Map to left hand keys

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <73 74 75 79 80 81 70 71 72 76 77 78 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 53 60 61 62 63 64 46 45 44 43>;
        };

        // 2. THUMB LAYER ACCESS
        // Thumbs use a "balanced" flavor so that if you press a thumb and a key
        // almost simultaneously, it still registers as a layer shift.

        thumb: thumb_layer_access {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // 3. ONE-SHOT STICKY KEYS
        // For fast capitalization without holding shift. Tap once for next key, 
        // tap twice to lock.

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
            ignore-modifiers;
        };

        // 4. SMART CAPS WORD
        // Automatically turns off caps when you hit space or a non-word character.

        smart_caps: caps_word {
            compatible = "zmk,behavior-caps-word";
            label = "SMART_CAPS";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE MINUS BSPC DEL N1 N2 N3 N4 N5 N6 N7 N8 N9 N0>;
        };

        td_sk_cl: td_sticky_caps_tog {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SK_CL";
            #binding-cells = <0>;
            bindings = <&smart_caps>, <&kp CAPS>;

            tapping-term-ms = <170>;
        };

        td_gmng: td_gmng {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_GAMING";
            #binding-cells = <0>;
            bindings = <&none>, <&tog 2>;

            tapping-term-ms = <190>;
        };
    };

    // ========================================================================
    // MACROS (Rolling bigrams and OS functions)
    // ========================================================================

    macros {
        dot_dot: dot_dot {
            compatible = "zmk,behavior-macro";
            label = "DOT_DOT";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp DOT &kp DOT>;
        };

        // Windows/Linux Magic SysReq

        sysrq: linux_magic_sysrq {
            compatible = "zmk,behavior-macro";
            label = "SYSRQ";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp PSCRN>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    // ========================================================================
    // KEYMAP LAYERS
    // ========================================================================

    chosen { zmk,matrix-transform = &imprint_function_row_full_bottom_row; };

    keymap {
        compatible = "zmk,keymap";

        layer_Enthium {
            bindings = <
&kp PSCRN  &kp F1        &kp F2        &kp F3         &kp F4          &kp F5                 &kp F6  &kp F7         &kp F8         &kp F9        &kp F10       &kp F11
&kp EQUAL  &kp N1        &kp N2        &kp N3         &kp N4          &kp N5                 &kp N6  &kp N7         &kp N8         &kp N9        &kp N0        &kp MINUS
&kp TAB    &kp Q         &kp Y         &kp O          &kp U           &kp EQUAL              &kp X   &kp L          &kp D          &kp P         &kp Z         &kp BSLH
&kp B      &hm_l LGUI C  &hm_l LALT I  &hm_l LCTRL A  &hm_l LSHFT E   &kp MINUS              &kp K   &hm_r RSHFT H  &hm_r RCTRL T  &hm_r RALT N  &hm_r RGUI S  &kp W
&td_sk_cl  &kp SQT       &kp COMMA     &kp DOT        &kp SEMI        &kp FSLH               &kp J   &kp M          &kp G          &kp F         &kp V         &smart_caps
&mo 7      &kp BSLH      &kp LPAR      &kp RPAR       &smart_caps                                    &smart_caps    &kp LBKT       &kp RBKT      &kp GRAVE     &mo 7
                                                      &thumb 3 SPACE  &thumb 4 TAB  &to 1    &to 1   &thumb 4 BSPC  &thumb 5 R
                                                      &thumb 6 ESC    &kp BSPC      &mo 7    &mo 7   &kp DEL        &thumb 6 RET
            >;
        };

        layer_QWERTY {
            bindings = <
&kp PSCRN  &kp F1        &kp F2        &kp F3         &kp F4          &kp F5                 &kp F6    &kp F7         &kp F8          &kp F9        &kp F10          &kp F11
&kp EQUAL  &kp N1        &kp N2        &kp N3         &kp N4          &kp N5                 &kp N6    &kp N7         &kp N8          &kp N9        &kp N0           &kp MINUS
&kp TAB    &kp Q         &kp W         &kp E          &kp R           &kp T                  &kp Y     &kp U          &kp I           &kp O         &kp P            &kp BSLH
&kp B      &hm_l LGUI A  &hm_l LALT S  &hm_l LCTRL D  &hm_l LSHFT F   &kp G                  &kp H     &hm_r RSHFT J  &hm_r RCTRL K   &hm_r RALT L  &hm_r RGUI SEMI  &kp SQT
&td_sk_cl  &kp Z         &kp X         &kp C          &kp V           &kp B                  &kp N     &kp M          &kp COMMA       &kp DOT       &kp FSLH         &smart_caps
&mo 7      &kp BSLH      &kp LPAR      &kp RPAR       &smart_caps                                      &smart_caps    &kp LBKT        &kp RBKT      &kp GRAVE        &mo 7
                                                      &thumb 3 SPACE  &thumb 4 TAB  &to 0    &to 0     &thumb 4 BSPC  &thumb 5 SPACE
                                                      &thumb 6 ESC    &kp BSPC      &none    &td_gmng  &kp DEL        &thumb 6 RET
            >;
        };

        layer_gaming {
            bindings = <
&kp ESCAPE  &kp F1            &kp F2        &kp F3  &kp F4        &kp F5                     &kp F1     &kp F2         &kp F3        &kp F4        &kp F5      &kp F6
&kp GRAVE   &kp N1            &kp N2        &kp N3  &kp N4        &kp N5                     &kp F7     &kp F8         &kp F9        &kp F10       &kp F11     &kp F12
&kp T       &kp TAB           &kp Q         &kp W   &kp E         &kp R                      &none      &none          &none         &none         &none       &none
&kp G       &kp LEFT_SHIFT    &kp A         &kp S   &kp D         &kp F                      &none      &kp LEFT       &kp UP        &kp DOWN      &kp RIGHT   &none
&kp B       &kp LEFT_CONTROL  &kp Z         &kp X   &kp C         &kp V                      &none      &none          &none         &none         &none       &none
&kp N       &kp LEFT_ALT      &kp NUMBER_6  &kp N7  &kp NUMBER_8                                        &none          &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &kp C_PLAY_PAUSE
                                                    &kp SPACE     &kp O   &kp PAUSE_BREAK    &kp COMMA  &kp BACKSPACE  &kp K
                                                    &kp Y         &kp H   &kp PERIOD         &td_gmng   &kp DEL        &kp ENTER
            >;
        };

        layer_Cursor {
            bindings = <
&none          &none      &none      &none          &none      &none                &none      &none        &none      &none      &none      &none
&none          &kp ESC    &kp INS    &kp LS(TAB)    &kp DEL    &none                &none      &none        &none      &none      &none      &none
&none          &kp RET    &kp SPACE  &kp TAB        &kp BSPC   &kp LC(X)            &kp LC(X)  &kp LS(TAB)  &kp LC(Z)  &kp LC(Y)  &kp TAB    &none
&smart_caps    &kp LGUI   &kp LALT   &kp LCTRL      &kp LSHFT  &kp LC(C)            &kp LC(C)  &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT  &smart_caps
&kp LC(L)      &kp LC(A)  &none      &none          &kp LC(F)  &kp LC(V)            &none      &kp HOME     &kp PG_DN  &kp PG_UP  &kp END    &kp LC(L)
&kp LC(SLASH)  &kp LC(Z)  &kp LC(Y)  &kp LC(LS(G))  &trans                                     &trans       &none      &none      &none      &trans
                                                    &trans     &trans     &trans    &trans     &trans       &trans
                                                    &trans     &trans     &trans    &trans     &trans       &trans
            >;
        };

        layer_Number {
            bindings = <
&none           &none      &none          &none        &none      &none             &none             &none                 &none         &none       &none                  &none
&none           &kp ESC    &kp INS        &kp LS(TAB)  &kp DEL    &none             &kp PIPE          &kp HASH              &kp STAR      &kp LS(N6)  &kp TILDE              &kp EXCLAMATION
&none           &kp RET    &kp SPACE      &kp TAB      &kp BSPC   &kp N0            &kp LS(G)         &kp KP_N7             &kp KP_N8     &kp KP_N9   &kp PLUS               &kp PERCENT
&smart_caps     &kp LGUI   &kp LALT       &kp LCTRL    &kp LSHFT  &kp X             &kp K             &kp KP_N4             &kp KP_N5     &kp KP_N6   &kp MINUS              &kp COLON
&kp E           &none      &none          &none        &kp LC(F)  &kp F             &kp J             &kp KP_N1             &kp KP_N2     &kp KP_N3   &kp FSLH               &kp CARET
&kp UNDERSCORE  &kp LC(Z)  &kp LC(LS(Z))  &none        &trans                                         &kp LEFT_PARENTHESIS  &kp LBKT      &kp RBKT    &kp RIGHT_PARENTHESIS  &kp AT_SIGN
                                                       &trans     &trans  &trans    &kp LESS_THAN     &kp KP_EQUAL          &kp KP_N0
                                                       &trans     &trans  &trans    &kp GREATER_THAN  &kp KP_DOT            &kp KP_COMMA
            >;
        };

        layer_Function {
            bindings = <
&none      &none     &none      &none        &none      &none                 &none       &none       &none       &none         &none         &none
&none      &kp ESC   &kp INS    &kp LS(TAB)  &kp DEL    &none                 &kp C_PREV  &kp C_PLAY  &kp C_NEXT  &kp C_STOP    &kp C_EJECT   &none
&none      &kp RET   &kp SPACE  &kp TAB      &kp BSPC   &kp K_CALC            &kp F7      &kp F8      &kp F9      &kp F10       &kp F13       &none
&kp LSHFT  &kp LGUI  &kp LALT   &kp LCTRL    &kp LSHFT  &kp K_WWW             &kp F4      &kp F5      &kp F6      &kp F11       &kp F14       &none
&none      &none     &none      &none        &kp LC(F)  &kp LG(E)             &kp F1      &kp F2      &kp F3      &kp F12       &kp F15       &none
&trans     &none     &none      &none        &trans                                       &trans      &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans
                                             &trans     &trans      &trans    &trans      &trans      &trans
                                             &trans     &trans      &trans    &trans      &trans      &trans
            >;
        };

        layer_Symbol {
            bindings = <
&none            &none          &none                 &none                  &none             &none                        &none          &none              &none             &none      &none          &none
&none            &kp GRAVE      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI          &kp COMMA                    &none          &none              &none             &none      &none          &none
&kp EXCLAMATION  &kp LBKT       &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp RBKT          &kp QUESTION                 &kp DOT        &kp DEL            &kp LS(TAB)       &kp INS    &kp ESC        &none
&kp POUND        &kp CARET      &kp EQUAL             &kp MINUS              &kp DOLLAR        &kp STAR                     &kp COMMA      &kp BSPC           &kp TAB           &kp SPACE  &kp RET        &kp GRAVE
&kp TILDE        &kp LESS_THAN  &kp PIPE              &kp UNDERSCORE         &kp GREATER_THAN  &kp FSLH                     &kp SEMICOLON  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp GRAVE  &kp BACKSLASH  &none
&dot_dot         &kp AMPERSAND  &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &kp PLUS                                                      &kp RIGHT_SHIFT    &kp RCTRL         &kp RALT   &kp RIGHT_WIN  &trans
                                                                             &kp BACKSLASH     &kp PERIOD    &kp STAR       &trans         &trans             &trans
                                                                             &kp PERCENT       &kp COLON     &kp AT_SIGN    &trans         &trans             &trans
            >;
        };

        layer_System {
            bindings = <
&sys_reset   &none            &none            &none            &none            &none                      &none            &none            &none            &none            &none            &sys_reset
&none        &none            &none            &none            &none            &none                      &none            &none            &none            &none            &none            &none
&none        &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF            &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &none
&none        &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR            &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &none
&none        &kp K_APP        &kp PSCRN        &kp PAUSE_BREAK  &rgb_ug RGB_TOG  &kp C_SLEEP                &sysrq           &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR
&bootloader  &none            &none            &none            &trans                                                       &trans           &kp SLCK         &kp CAPS         &kp K_APP        &bootloader
                                                                &trans           &trans           &trans    &trans           &trans           &trans
                                                                &trans           &trans           &trans    &trans           &trans           &trans
            >;
        };
    };
};
