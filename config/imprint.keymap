#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/hid_usage.h>

/ {
    // ========================================================================
    // ADVANCED BEHAVIORS (Adapted from Sunaku's "Glorious Engrammer")
    // ========================================================================

    behaviors {
// 1. HOME ROW MODS (HRM) - BILATERAL COMBINATIONS
        // Sunaku's "Difficulty Level 2" translates to roughly 200ms tap terms 
        // with a 150ms streak decay. This ensures that at 90wpm, rolling keys 
        // won't accidentally trigger a Shift or Ctrl.

        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;

            // NOTE: To make this strictly bilateral (only fires when you press 
            // a key on the opposite hand), you must define your right hand key positions.
            // hold-trigger-key-positions = < 6 7 8 ... >; 

            bindings = <&kp>, <&kp>;
    };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;

            // hold-trigger-key-positions = < 0 1 2 ... >; // Map to left hand keys

            bindings = <&kp>, <&kp>;
        };

        // 2. THUMB LAYER ACCESS
        // Thumbs use a "balanced" flavor so that if you press a thumb and a key
        // almost simultaneously, it still registers as a layer shift.

        thumb: thumb_layer_access {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // 3. ONE-SHOT STICKY KEYS
        // For fast capitalization without holding shift. Tap once for next key, 
        // tap twice to lock.

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <500>;
            quick-release;
            ignore-modifiers;
        };

        // 4. SMART CAPS WORD
        // Automatically turns off caps when you hit space or a non-word character.

        smart_caps: caps_word {
            compatible = "zmk,behavior-caps-word";
            label = "SMART_CAPS";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE MINUS BSPC DEL N1 N2 N3 N4 N5 N6 N7 N8 N9 N0>;
        };
    };

    // ========================================================================
    // MACROS (Rolling bigrams and OS functions)
    // ========================================================================

    macros {
dot_dot: dot_dot {
            compatible = "zmk,behavior-macro";
            label = "DOT_DOT";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp DOT &kp DOT>;
    };

        // Windows/Linux Magic SysReq

        sysrq: linux_magic_sysrq {
            compatible = "zmk,behavior-macro";
            label = "SYSRQ";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp PSCRN>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    // ========================================================================
    // KEYMAP LAYERS
    // ========================================================================

    chosen { zmk,matrix-transform = &imprint_function_row_full_bottom_row; };

    keymap {
        compatible = "zmk,keymap";

        layer_Enthium {
            bindings = <
&kp PSCRN  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
&kp TAB  &kp Q  &kp Y  &kp O  &kp U  &kp EQUAL  &kp X  &kp L  &kp D  &kp P  &kp Z  &kp BSLH
&kp B  &hm_l LGUI C  &hm_l LALT I  &hm_l LCTRL A  &hm_l LSHFT E  &kp MINUS  &kp K  &hm_r RSHFT H  &hm_r RCTRL T  &hm_r RALT N  &hm_r RGUI S  &kp W
&kp LSHFT  &kp SQT  &kp COMMA  &kp DOT  &kp SEMI  &kp FSLH  &kp J  &kp M  &kp G  &kp F  &kp V  &kp RSHFT
&trans  &kp BSLH  &kp LPAR  &kp RPAR  &trans  &trans  &kp LBKT  &kp RBKT  &kp GRAVE  &trans
&thumb 3 SPACE  &thumb 4 TAB  &to 1  &to 1  &thumb 4 BSPC  &thumb 5 R
&thumb 6 ESC  &kp BSPC  &mo 7  &mo 7  &kp DEL  &thumb 6 RET
            >;
        };

        layer_QWERTY {
            bindings = <
&kp PSCRN  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
&kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH
&kp B  &hm_l LGUI A  &hm_l LALT S  &hm_l LCTRL D  &hm_l LSHFT F  &kp G  &kp H  &hm_r RSHFT J  &hm_r RCTRL K  &hm_r RALT L  &hm_r RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&trans  &kp BSLH  &kp LPAR  &kp RPAR  &trans  &tog 2  &kp LBKT  &kp RBKT  &kp GRAVE  &trans
&thumb 3 SPACE  &thumb 4 TAB  &to 0  &to 0  &thumb 4 BSPC  &thumb 5 SPACE
&thumb 6 ESC  &kp BSPC  &mo 7  &mo 7  &kp DEL  &thumb 6 RET
            >;
        };

        layer_gaming {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp T  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &none  &none  &kp I  &none  &none  &none
&kp G  &kp LEFT_SHIFT  &kp A  &kp S  &kp D  &kp F  &none  &hm_r RSHFT J  &hm_r RCTRL K  &hm_r RALT L  &none  &none
&kp B  &kp LEFT_CONTROL  &kp Z  &kp X  &kp C  &kp V  &none  &none  &none  &none  &none  &none
&kp N  &kp LEFT_ALT  &kp NUMBER_6  &kp N7  &kp NUMBER_8  &tog 2  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &kp C_PLAY_PAUSE
&kp SPACE  &kp O  &kp DOT  &mo 5  &kp BACKSPACE  &kp ENTER
&kp Y  &kp H  &kp PAUSE_BREAK  &none  &kp DEL  &none
            >;
        };

        layer_Cursor {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &kp ESC  &kp INS  &kp LS(TAB)  &kp DEL  &none  &none  &none  &none  &none  &none  &none
&none  &kp RET  &kp SPACE  &kp TAB  &kp BSPC  &kp LC(X)  &kp LC(X)  &kp LS(TAB)  &kp LC(Z)  &kp LC(Y)  &kp TAB  &none
&kp LSHFT  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &kp LC(C)  &kp LC(C)  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp LSHFT
&kp LC(L)  &kp LC(A)  &none  &none  &kp LC(F)  &kp LC(V)  &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp LC(L)
&trans  &kp LC(Z)  &kp LC(Y)  &kp LC(LS(G))  &trans  &trans  &none  &none  &none  &trans
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Number {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &kp ESC  &kp INS  &kp LS(TAB)  &kp DEL  &none  &kp LS(BSLH)  &kp LS(N3)  &kp LS(N4)  &kp LS(N6)  &kp LS(GRAVE)  &kp LS(N1)
&none  &kp RET  &kp SPACE  &kp TAB  &kp BSPC  &kp N0  &kp LS(G)  &kp N7  &kp N8  &kp N9  &kp LS(SEMI)  &kp LS(N5)
&kp LSHFT  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &kp X  &kp K  &kp N4  &kp N5  &kp N6  &kp MINUS  &kp LS(EQUAL)
&kp E  &none  &none  &none  &kp LC(F)  &kp F  &none  &kp N1  &kp N2  &kp N3  &kp FSLH  &kp LS(N8)
&trans  &none  &none  &none  &trans  &trans  &kp DOT  &kp N0  &kp LS(N9)  &trans
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Function {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &kp ESC  &kp INS  &kp LS(TAB)  &kp DEL  &none  &kp C_PREV  &kp C_PLAY  &kp C_NEXT  &kp C_STOP  &kp C_EJECT  &none
&none  &kp RET  &kp SPACE  &kp TAB  &kp BSPC  &kp K_CALC  &kp F7  &kp F8  &kp F9  &kp F10  &kp F13  &none
&kp LSHFT  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &kp K_WWW  &kp F4  &kp F5  &kp F6  &kp F11  &kp F14  &none
&none  &none  &none  &none  &kp LC(F)  &kp LG(E)  &kp F1  &kp F2  &kp F3  &kp F12  &kp F15  &none
&trans  &none  &none  &none  &trans  &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_Symbol {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &kp GRAVE  &kp LS(N9)  &kp LS(N0)  &kp SEMI  &kp COMMA  &none  &none  &none  &none  &none  &none
&kp LS(N1)  &kp LBKT  &kp LS(LBKT)  &kp LS(RBKT)  &kp RBKT  &kp LS(FSLH)  &kp DOT  &kp DEL  &kp LS(TAB)  &kp INS  &kp ESC  &none
&kp LS(N3)  &kp LS(N6)  &kp EQUAL  &kp LS(MINUS)  &kp LS(N4)  &kp LS(N8)  &kp COMMA  &kp BSPC  &kp TAB  &kp SPACE  &kp RET  &kp GRAVE
&kp LS(GRAVE)  &kp LS(COMMA)  &kp LS(BSLH)  &kp MINUS  &kp LS(DOT)  &kp FSLH  &kp BSLH  &kp DOT  &kp LS(N8)  &kp SEMI  &kp SQT  &kp BSLH
&trans  &dot_dot  &kp LS(N7)  &kp SQT  &trans  &trans  &kp LS(N2)  &none  &none  &trans
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_System {
            bindings = <
&sys_reset  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &sys_reset
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &none
&none  &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFR  &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &none
&none  &kp K_APP  &kp PSCRN  &kp PAUSE_BREAK  &rgb_ug RGB_TOG  &kp C_SLEEP  &sysrq  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
&bootloader  &none  &none  &none  &trans  &trans  &kp SLCK  &kp CAPS  &kp K_APP  &bootloader
&trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
